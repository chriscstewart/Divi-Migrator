# Divi Migrator — local secrets template.
#
# 1. Copy this file to `.env`  ->  `cp .env.example .env`
# 2. Fill in REAL values. `.env` is git-ignored and must NEVER be committed.
# 3. For each new deployment/site, collect that site's own URL + app password.
#
# WordPress REST API (env prefix WP_)
WP_URL=https://www.example.com
WP_USER=your-wp-username
WP_APP_PASSWORD=your-application-password-no-spaces
WP_SSL_VERIFY=true
WP_TIMEOUT=60

# DiviOps MCP (often the same site/credentials as WP; env prefix DIVIOPS_)
DIVIOPS_URL=https://www.example.com
DIVIOPS_USER=your-wp-username
DIVIOPS_APP_PASSWORD=your-application-password-no-spaces
DIVIOPS_TIMEOUT=90
